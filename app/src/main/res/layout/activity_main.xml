<?xml version="1.0" encoding="utf-8"?>


<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BetterHabitsAI ✨"
                android:textSize="10sp"
                android:letterSpacing="0.20"
                android:textColor="#F5C842"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Définis tes objectifs"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#F0EDE8"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Que veux-tu accomplir ?"
                android:textSize="15sp"
                android:textColor="#9A95A0"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Goals card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OBJECTIFS"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:textColor="#F5C842"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qu’est-ce qui compte le plus pour toi ?"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#F0EDE8"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cbGoalFit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get fit"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:buttonTint="#F5C842"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbGoalStudy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Study better"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:buttonTint="#F5C842"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbGoalSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sleep earlier"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:buttonTint="#F5C842"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbGoalDiscipline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Be more disciplined"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:buttonTint="#F5C842"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etCustomGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ajouter un objectif personnalisé..."
                android:textColorHint="#4A4860"
                android:textColor="#F0EDE8"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Habits card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HABITUDES QUOTIDIENNES"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:textColor="#7EC8A4"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Construis ton rituel quotidien"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#F0EDE8"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/cbHabitGym"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gym"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:buttonTint="#7EC8A4"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbHabitStudy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Study 2 hours"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:buttonTint="#7EC8A4"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbHabitWater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drink water"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:buttonTint="#7EC8A4"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbHabitSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sleep before 11 PM"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:buttonTint="#7EC8A4"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etCustomHabit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ajouter une habitude personnalisée..."
                android:textColorHint="#4A4860"
                android:textColor="#F0EDE8"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Save CTA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/btnSaveAndNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enregistrer et continuer →"
                android:textColor="#1A1200"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/bg_button_primary"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>