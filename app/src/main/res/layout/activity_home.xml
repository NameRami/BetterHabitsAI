<?xml version="1.0" encoding="utf-8"?>


<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ── HEADER ZONE ───────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="28dp">

            <!-- Eyebrow label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BetterHabitsAI"
                android:textSize="10sp"
                android:letterSpacing="0.20"
                android:textColor="#F5C842"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <!-- Main greeting -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bon retour"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="#F0EDE8"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.1" />

            <!-- Subtitle date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monday, April 20"
                android:textSize="15sp"
                android:textColor="#9A95A0"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- ── STATS ROW ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="20dp">

            <!-- Stat card: Entries -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="16dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTRÉES"
                    android:textSize="9sp"
                    android:letterSpacing="0.15"
                    android:textColor="#4A4860"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvTotalLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#F5C842"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="jours de journal"
                    android:textSize="11sp"
                    android:textColor="#4A4860" />

            </LinearLayout>

            <!-- Stat card: Avg Mood -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="16dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HUMEUR MOYENNE"
                    android:textSize="9sp"
                    android:letterSpacing="0.15"
                    android:textColor="#4A4860"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvAvgMood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#7EC8A4"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sur 5,0"
                    android:textSize="11sp"
                    android:textColor="#4A4860" />

            </LinearLayout>

        </LinearLayout>

        <!-- Hidden combined stats view for the original id reference -->
        <TextView
            android:id="@+id/tvStats"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- ── MOOD CHART CARD ────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:padding="20dp">

            <!-- Chart header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TENDANCE DE L’HUMEUR"
                        android:textSize="9sp"
                        android:letterSpacing="0.15"
                        android:textColor="#4A4860"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 derniers jours"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#F0EDE8"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Legend dot -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#F5C842"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="humeur"
                    android:textSize="12sp"
                    android:textColor="#9A95A0" />

            </LinearLayout>

            <!-- The LineChart — styled via Java code -->
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChartMood"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

        </LinearLayout>

        <!-- ── ACTION CARDS ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIONS RAPIDES"
                android:textSize="9sp"
                android:letterSpacing="0.15"
                android:textColor="#4A4860"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="14dp" />

            <!-- Daily Check-In — PRIMARY gold action -->
            <LinearLayout
                android:id="@+id/btnDailyCheckIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_gold"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Icon container -->
                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill_gold"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✦"
                        android:textSize="20sp"
                        android:textColor="#F5C842" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bilan quotidien"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#F0EDE8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Note ton humeur, tes habitudes et tes victoires"
                        android:textSize="13sp"
                        android:textColor="#9A95A0"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="20sp"
                    android:textColor="#F5C842" />

            </LinearLayout>

            <!-- Chat with AI -->
            <LinearLayout
                android:id="@+id/btnChatAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_card_sage"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◈"
                        android:textSize="20sp"
                        android:textColor="#7EC8A4" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Discuter avec le coach IA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#F0EDE8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Demande ce que tu veux, gagne en clarté"
                        android:textSize="13sp"
                        android:textColor="#9A95A0"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="20sp"
                    android:textColor="#9A95A0" />

            </LinearLayout>

            <!-- Weekly Report -->
            <LinearLayout
                android:id="@+id/btnWeeklyReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▦"
                        android:textSize="20sp"
                        android:textColor="#9A95A0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Analyse hebdomadaire"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#F0EDE8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tes schémas sur 7 jours et ton rapport"
                        android:textSize="13sp"
                        android:textColor="#9A95A0"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="20sp"
                    android:textColor="#9A95A0" />

            </LinearLayout>

            <!-- Edit Goals -->
            <LinearLayout
                android:id="@+id/btnSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◎"
                        android:textSize="20sp"
                        android:textColor="#9A95A0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Objectifs et habitudes"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#F0EDE8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modifie ta feuille de route personnelle"
                        android:textSize="13sp"
                        android:textColor="#9A95A0"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="20sp"
                    android:textColor="#9A95A0" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
