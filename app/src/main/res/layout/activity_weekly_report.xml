<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BILAN SUR 7 JOURS"
                android:textSize="10sp"
                android:letterSpacing="0.20"
                android:textColor="#7EC8A4"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyse hebdomadaire"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#F0EDE8"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tes schémas, tes progrès et ton élan"
                android:textSize="15sp"
                android:textColor="#9A95A0"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Report content card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_sage"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:padding="24dp">

            <!-- Sage accent stripe -->
            <LinearLayout
                android:layout_width="32dp"
                android:layout_height="3dp"
                android:background="#7EC8A4"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tvReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Génération de ton analyse hebdomadaire..."
                android:textSize="16sp"
                android:textColor="#F0EDE8"
                android:lineSpacingMultiplier="1.65"
                android:letterSpacing="0.01" />

        </LinearLayout>

        <!-- Back button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retour à l’accueil"
                android:textColor="#F0EDE8"
                android:textSize="15sp"
                android:background="@drawable/bg_button_secondary"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
